PORT=3001
NODE_ENV=production

JWT_SECRET=CHANGE_THIS_TO_LONG_RANDOM_SECRET

GROQ_API_KEY=

FRONTEND_URL=https://wappflow.remoteops.co

PUPPETEER_SKIP_DOWNLOAD=true

# Optional: VAPID keys for push notifications (generate with web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: Google OAuth
GOOGLE_CLIENT_ID=

# ── Platform email (PROP-006) — password resets, email verification, support replies.
# Without these, those emails are silently skipped. Any SMTP provider works
# (Google Workspace, Zoho, Brevo, Mailgun, Amazon SES…).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WappFlow <support@yourdomain.com>"
# Shown on the forgot-password page as a fallback contact.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── Off-site encrypted backups to Cloudflare R2 (PROP-006) ─────────────────────
# Turn on by setting the bucket. The key encrypts every file before upload —
# keep a copy somewhere safe OUTSIDE this server, or the backups can't be restored.
BACKUP_R2_BUCKET=
BACKUP_ENCRYPTION_KEY=          # openssl rand -hex 32
BACKUP_R2_ACCOUNT_ID=           # or BACKUP_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=

# ── Trials (PROP-006) — every new workspace starts here, then drops to Creator.
TRIAL_PLAN=studio
TRIAL_DAYS=14

# API rate limit per 15 minutes. Signed-in users are counted per user; anything
# without a valid session (public pages, sign-up) is counted per IP address.
# RATE_LIMIT_USER=3000
# RATE_LIMIT_IP=500
